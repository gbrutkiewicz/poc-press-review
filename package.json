{
  "name": "doc-scanner-agent",
  "version": "0.1.0",
  "description": "MVP local : scan, extraction (PDF/DOCX/images+OCR) et tagging de documents sur listes fermées — zéro cloud",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "npm run build && npm start",
    "samples": "node dist/scripts/generate-samples.js",
    "scan": "node dist/scripts/scan-dir.js",
    "test": "npm run build && node --test dist/tests/tagging.test.js dist/tests/e2e.test.js dist/tests/validated.test.js",
    "seed": "node dist/scripts/seed-validated.js"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "4.10.38",
    "sharp": "^0.35.5",
    "tesseract.js": "^6.0.1",
    "uuid": "^11.1.0"
  },
  "optionalDependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/uuid": "^9.0.8",
    "docx": "^9.1.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.6.3"
  }
}
