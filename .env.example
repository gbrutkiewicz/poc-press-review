# Copier vers .env (facultatif : toutes les valeurs ont un défaut)

# Serveur — écoute uniquement en local par défaut
HOST=127.0.0.1
PORT=3000

# Répertoires (relatifs à la racine du projet)
DATA_DIR=./data
INPUT_DIR=./data/input
# Racines supplémentaires autorisées pour POST /api/scan (séparées par des virgules)
ALLOWED_ROOTS=

# Taille max d'un fichier scanné (Mo)
MAX_FILE_SIZE_MB=50

# Tagging
REVIEW_THRESHOLD=0.6
MIN_TAG_SCORE=0.2

# OCR (langues tesseract embarquées : fra, eng)
OCR_LANGS=fra+eng

# Surveillance automatique de INPUT_DIR (chokidar)
WATCH=true

# Ollama (optionnel) : auto = utilisé si disponible, off = jamais, always = sur tous les docs
# L'URL doit pointer sur localhost (refus de toute autre machine).
OLLAMA_MODE=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
